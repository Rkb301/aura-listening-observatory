{
  "name": "aura-local-music",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "description": "AURA Listening Observatory — local-first Spotify client powered by Soloist",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:web": "node scripts/build-web.mjs",
    "check:web": "node scripts/build-web.mjs --check",
    "test:browser": "node scripts/verify-browser.mjs",
    "doctor:linux": "bash scripts/doctor-linux.sh",
    "test:soak:local": "node scripts/soak-local.mjs",
    "desktop:start": "electron .",
    "desktop:package:linux": "electron-builder --linux AppImage",
    "desktop:package:windows": "electron-builder --win nsis",
    "desktop:package:windows:zip": "electron-builder --win zip"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "app.raishin.aura",
    "productName": "AURA",
    "asar": true,
    "directories": {
      "output": "releases/native"
    },
    "files": [
      "desktop/**/*",
      "server.mjs",
      "lib/**/*",
      "public/**/*",
      "scripts/aura-audio-bridge.sh",
      "package.json",
      "!vendor/**/*",
      "!backups/**/*",
      "!releases/**/*",
      "!test-artifacts/**/*",
      "!**/*.log",
      "!**/.aura-music/**/*",
      "!**/auth.json",
      "!**/tokens.json",
      "!**/soloist-key",
      "scripts/aura-mpris-linux.py"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "public/icon-512.png",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "desktop/aura.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "executableName": "aura"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "desktopName": "aura.desktop"
}
